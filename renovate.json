{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>nuxt/renovate-config-nuxt"
  ],
  "minimumReleaseAge": "2 days",
  "schedule": ["before 3am on Monday"],
  "timezone": "UTC",
  "packageRules": [
    {
      "matchDepTypes": ["resolutions"],
      "enabled": false
    },
    {
      "description": "Same weekly window as the repo (nuxt preset uses a broader schedule for framework packages)",
      "schedule": ["before 3am on Monday"],
      "matchPackageNames": [
        "/^@nuxt//",
        "/^nuxt/"
      ]
    },
    {
      "description": "eve and its extensions declare a shared capability contract, so they bump together",
      "matchPackageNames": ["eve", "@agent-browser/eve", "@github-tools/eve-extension"],
      "groupName": "eve"
    }
  ],
  "postUpdateOptions": ["pnpmDedupe"]
}
