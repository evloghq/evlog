{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>nuxt/renovate-config-nuxt",
    "customManagers:githubActionsVersions"
  ],
  "minimumReleaseAge": "2 days",
  "schedule": ["before 3am on Monday"],
  "timezone": "UTC",
  "packageRules": [
    {
      "matchDepTypes": ["resolutions"],
      "enabled": false
    },
    {
      "description": "Same weekly window as the repo (nuxt preset uses a broader schedule for framework packages)",
      "schedule": ["before 3am on Monday"],
      "matchPackageNames": [
        "/^@nuxt//",
        "/^nuxt/"
      ]
    },
    {
      "description": "eve and its extensions declare a shared capability contract, so they bump together",
      "matchPackageNames": ["eve", "@agent-browser/eve", "@github-tools/eve-extension"],
      "groupName": "eve"
    },
    {
      "description": "Evi stays on its pinned eve and extensions until eve 1.0 is stable: later 0.x releases change the agent APIs it uses",
      "matchFileNames": ["apps/evi/package.json"],
      "matchPackageNames": ["eve", "@agent-browser/eve", "@github-tools/eve-extension"],
      "enabled": false
    },
    {
      "description": "Keep the eve peer floor where it is: a new eve release must not raise the minimum evlog accepts",
      "matchFileNames": ["packages/evlog/package.json"],
      "matchDepTypes": ["peerDependencies"],
      "matchPackageNames": ["eve"],
      "rangeStrategy": "widen"
    }
  ],
  "postUpdateOptions": ["pnpmDedupe"]
}
