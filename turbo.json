{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "noUpdateNotifier": true,
  "globalPassThroughEnv": [
    "CI",
    "GITHUB_ACTIONS",
    "GITHUB_EVENT_NAME",
    "GITHUB_REF",
    "GITHUB_SHA",
    "TMPDIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "dev:prepare"],
      "outputs": [
        "dist/**",
        ".nuxt/**",
        ".output/**",
        ".vercel/output/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        ".svelte-kit/**",
        "build/**"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "env": [
        "NUXT_SITE_URL",
        "AI_GATEWAY_API_KEY",
        "AXIOM_TOKEN",
        "AXIOM_DATASET",
        "OTLP_ENDPOINT",
        "POSTHOG_API_KEY",
        "POSTHOG_HOST",
        "NUXT_PUBLIC_POSTHOG_KEY",
        "SENTRY_DSN",
        "BETTER_STACK_SOURCE_TOKEN",
        "DATABASE_URL",
        "ANALYTICS_PASSWORD",
        "NUXT_SESSION_PASSWORD",
        "ANALYTICS_ALLOWED_TOOLS",
        "ANALYTICS_ALLOWED_CUSTOM_KEYS"
      ]
    },
    "render-labs#build": {
      "dependsOn": ["dev:prepare"],
      "outputs": [".nuxt/**", ".output/**", ".vercel/output/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "env": ["NUXT_PUBLIC_SITE_URL"]
    },
    "render-labs#dev:prepare": {
      "dependsOn": ["evlog-docs#dev:prepare"],
      "outputs": [".nuxt/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"]
    },
    "dev": {
      "dependsOn": ["dev:prepare"],
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "env": [
        "AI_GATEWAY_API_KEY",
        "AXIOM_TOKEN",
        "AXIOM_DATASET",
        "OTLP_ENDPOINT",
        "POSTHOG_API_KEY",
        "POSTHOG_HOST",
        "NUXT_PUBLIC_POSTHOG_KEY",
        "SENTRY_DSN",
        "BETTER_STACK_SOURCE_TOKEN",
        "DATABASE_URL",
        "ANALYTICS_PASSWORD",
        "NUXT_SESSION_PASSWORD",
        "ANALYTICS_ALLOWED_TOOLS",
        "ANALYTICS_ALLOWED_CUSTOM_KEYS"
      ]
    },
    "dev:prepare": {
      "dependsOn": ["^dev:prepare", "^build"],
      "outputs": ["dist/**", ".nuxt/**", ".output/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"]
    },
    "lint": {
      "dependsOn": ["dev:prepare"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"]
    },
    "lint:fix": {
      "dependsOn": ["dev:prepare"],
      "cache": false
    },
    "bench": {
      "dependsOn": ["^dev:prepare"],
      "cache": false
    },
    "test": {
      "dependsOn": ["dev:prepare"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["dev:prepare"]
    },
    "eval": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["AI_GATEWAY_API_KEY", "VERCEL_OIDC_TOKEN"]
    }
  }
}
