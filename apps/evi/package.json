{
  "name": "evi",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "vercel-build": "turbo run build --filter=evlog && eve build",
    "dev": "eve dev",
    "eval": "EVE_RUN_MODE=eval eve eval",
    "start": "eve start",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@agent-browser/eve": "^0.36.0",
    "@github-tools/eve-extension": "^0.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@posthog/ai": "^8.11.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/connect": "^2.0.4",
    "@vercel/oidc": "^3.8.7",
    "@vercel/otel": "^2.1.3",
    "ai": "^7.0.97",
    "eve": "^0.49.1",
    "evlog": "workspace:*",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "microsandbox": "^0.6.18",
    "typescript": "7.0.2",
    "vitest": "^4.1.11",
    "postgres": "^3.4.9"
  }
}
