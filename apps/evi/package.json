{
  "name": "evi",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "vercel-build": "turbo run build --filter=evlog && eve build",
    "dev": "eve dev",
    "eval": "EVE_RUN_MODE=eval eve eval",
