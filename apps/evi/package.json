    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@agent-browser/eve": "file:./vendor/agent-browser-eve-0.38.2-eve0.74.0.tgz",
    "@github-tools/eve-extension": "0.8.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@posthog/ai": "^8.13.4",
    "@vercel/blob": "^2.8.0",
    "@vercel/connect": "^2.4.1",
    "@vercel/oidc": "^3.8.9",
    "@vercel/otel": "^2.1.3",
    "ai": "^7.0.128",
    "eve": "0.74.0",
    "evlog": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "microsandbox": "^0.7.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.11",
    "postgres": "^3.4.9",
    "yaml": "^2.9.1"
  }
}
