{
  "name": "evi",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "vercel-build": "turbo run build --filter=evlog && eve build",
    "dev": "eve dev",
    "eval": "EVE_RUN_MODE=eval eve eval",
    "start": "eve start",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@agent-browser/eve": "file:./vendor/agent-browser-eve-0.38.1-eve0.64.1.tgz",
    "@github-tools/eve-extension": "0.8.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@posthog/ai": "^8.16.3",
    "@vercel/blob": "^2.8.2",
    "@vercel/connect": "^2.5.5",
    "@vercel/oidc": "^3.8.10",
    "@vercel/otel": "^2.1.3",
    "ai": "^7.0.153",
    "eve": "0.71.3",
    "evlog": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "microsandbox": "^0.7.10",
    "typescript": "7.0.2",
    "vitest": "^4.1.12",
    "postgres": "^3.4.9",
    "yaml": "^2.9.1"
  }
}
