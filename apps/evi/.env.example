# The repository Evi is deployed for, as an owner/repo slug. It is what the
# sandbox template clones, the default for the GitHub tools, and where
# git__push lands unless told otherwise. Unset means evloghq/evlog. The GitHub
# App must be installed on it.
# EVI_REPOSITORY=evloghq/evlog

# Set to 1 to enable Evi's memory slot (eve's file memory). Unsetting it is
# the whole rollback: the slot disappears and the stored document is untouched.
# EVI_MEMORY_ENABLED=1

# Read-write token of the private Vercel Blob store holding the memory
# document. Unset, the document lives in process-local storage, which is what
# `eve dev` wants. A token is required on a deployment: the store must be
# private and separate from the public one the screenshot tools upload to.
# Use the token rather than EVE_MEMORY_BLOB_STORE_ID, whose OIDC authorization
# only covers the environments the store is connected to.
# EVE_MEMORY_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Configure a dedicated channel for external PR review approvals.
# Invite Evi and enable Slack interactivity at /eve/v1/slack.
# Subscribe the GitHub connector to pull_request events.
# EVI_PR_REVIEW_SLACK_CHANNEL_ID=C...
# EVI_SLACK_TEAM_ID=T...
