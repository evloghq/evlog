{
  "name": "evlog-monorepo",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evloghq/evlog.git"
  },
  "author": "HugoRCD",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo run dev --filter=evlog-playground",
    "dev:prepare": "turbo run dev:prepare",
    "docs": "turbo run dev --filter=evlog-docs",
    "lab": "turbo run dev --filter=render-labs",
    "telemetry": "turbo run dev --filter=evlog-telemetry",
    "telemetry:cli": "EVLOG_TELEMETRY=1 EVLOG_TELEMETRY_ENDPOINT=http://localhost:3000/api/telemetry/ingest node packages/cli/bin/evlog.mjs",
    "example": "node scripts/run-app.mjs example",
    "playground": "node scripts/run-app.mjs playground",
    "build": "turbo run build",
    "build:package": "turbo run build --filter='./packages/*'",
    "build:docs": "turbo run build --filter=evlog-docs",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "bench": "turbo run bench --filter='./packages/*'",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter evlog run test:e2e",
    "sandbox:up": "docker compose -f packages/evlog/test/e2e/docker-compose.yml up -d --wait",
    "sandbox:seed": "node packages/evlog/test/e2e/seed.mjs",
    "sandbox:down": "docker compose -f packages/evlog/test/e2e/docker-compose.yml down -v",
    "sandbox:e2e": "LOKI_ENDPOINT=http://localhost:3100 CLICKHOUSE_ENDPOINT=http://localhost:8123 pnpm run test:e2e",
    "cli": "node packages/cli/bin/evlog.mjs",
    "content:lint": "node scripts/content-lint/index.mjs",
    "content:lint:test": "vitest run --root scripts/content-lint",
    "cli:sandbox": "node scripts/cli-sandbox.mjs",
    "test:coverage": "pnpm --filter evlog run test:coverage",
    "test:coverage:open": "pnpm --filter evlog run test:coverage && open packages/evlog/coverage/index.html",
    "mutate": "pnpm --filter evlog run mutate",
    "mutate:open": "pnpm --filter evlog run mutate && open packages/evlog/reports/mutation/mutation.html",
    "api:snapshot": "pnpm --filter evlog exec vitest run test/toolkit/api-surface.test.ts",
    "api:snapshot:update": "pnpm --filter evlog exec vitest run test/toolkit/api-surface.test.ts --update",
    "typecheck": "turbo run typecheck",
    "automd": "npx automd --config .github/automd.json",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build --filter='./packages/*' && changeset publish"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.10",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@hrcd/eslint-config": "^3.0.3",
    "@types/node": "^25.9.5",
    "ai": "^7.0.92",
    "automd": "^0.4.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "h3": "^1.15.11",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "24.x"
  }
}
